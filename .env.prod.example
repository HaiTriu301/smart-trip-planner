# Values for docker-compose.prod.yml on the server (design.md 17.3). Copy it there as .env, next to the compose
# file, then fill in every value:  cp .env.prod.example .env && chmod 600 .env
# The copy holds secrets: it never leaves the server and never goes into Git.
# DB_URL and REDIS_HOST are not here: they are the service names written in docker-compose.prod.yml.
# Random secrets:  openssl rand -hex 48  (JWT_SECRET)  ·  openssl rand -hex 24  (the two database passwords)

# Image version: latest, or the short commit hash of an older build to go back to it
IMAGE_TAG=latest

# Database. The backend gets DB_USER / DB_PASSWORD; only MySQL gets the root password
DB_USER=tripuser
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# At least 64 characters. Changing it signs every user out
JWT_SECRET=

# https://<domain>, no trailing slash: allowed origin of the API and base of the links in mail
APP_FRONTEND_URL=https://example.com

# Mail through Brevo. The sender must be an address of the domain verified on Brevo
APP_MAIL_FROM=no-reply@example.com
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo -> SMTP & API -> SMTP: the login and an SMTP key
MAIL_USERNAME=
MAIL_PASSWORD=
